<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Horus.Agent</AssemblyName>
    <RootNamespace>Horus.Agent</RootNamespace>

    <!-- 默认管理员运行:requireAdministrator manifest(双击即 UAC 提权,免右键)。见 app.manifest 内注释。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- UIAutomation(System.Windows.Automation, 讀瀏覽器位址欄) 需 WPF 程式集;
         隱藏訊息視窗(剪貼簿) + Screen 資訊 需 WinForms。兩者在 net*-windows 下可共存。 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 單檔案自包含發佈(命令見 README，註解內避免出現連字號對以符合 XML)：
         publish -c Release -r win-x64 self-contained + PublishSingleFile + IncludeNativeLibrariesForSelfExtract -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF/UseWindowsForms 用裁剪版隱式 using 替換預設集(加入 Drawing/Forms、去掉 IO/Net.Http)，
         這裡把被去掉的兩個補回為全域 using，避免逐檔案重複引入。 -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- 平台无关采集核心(传输/续传/重连/缓冲/配置)。传递引入 Horus.Contracts。 -->
    <ProjectReference Include="..\agentcore\Horus.Agent.Core.csproj" />
    <!-- 共享线协议 / canonical / HMAC(Program 直接用 AgentEvent/Envelope/SignalType) -->
    <ProjectReference Include="..\contracts\Horus.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 截图编码为 WebP(3.1.12 修复 3.1.5 的已知高/中危漏洞 GHSA-2cmq-823j-5qj8 等) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 进程/USB 事件: WMI -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- 屏幕抓取(Windows-only) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <!-- M5 保活层1:作为 Windows 服务(LocalSystem)运行看门狗;UseWindowsService 提供 SCM 集成 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- UIAutomationClient / UIAutomationTypes 由 UseWPF 的 WindowsDesktop 引用包自動帶入,
       顯式 <Reference> 會與之衝突(MSB3243),故移除;System.Windows.Automation 仍可解析。 -->

</Project>
