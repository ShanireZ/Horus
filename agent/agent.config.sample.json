{
  // ★ 本檔案**整個可選** —— 所有欄位都有內置預設,刪掉設定檔案也能跑(零設定部署)。
  //   只在某項預設不適用時,把對應欄位留在這裡覆蓋;其餘可全刪。

  // 伺服器位址:唯一常需按現場核對的欄位(內置預設見下)。考場伺服器 IP 不是這個就改這兩行:
  "serverWsBase": "ws://192.168.32.145:8080",
  "serverHttpBase": "http://192.168.32.145:8080",

  // 本機身分:**留空即自動用主機名**(machineId=主機名·agentId="ag-"+主機名),逐臺免配。
  // 要人工指定座位標籤才填(否則刪掉這兩行)。
  "agentId": "",
  "machineId": "",

  // 採集鑑權:預設 oidc(啟動待命,開考彈瀏覽器登入**貝塔通**)。以下三項都有預設,一般不用寫。
  //
  // ⚠★★★ 2026-08-26:本行此前寫著 "oidcIssuer": "https://betaoi.cc",而那个值**落后两代** ——
  //   它是**問天錄時期**的域(貝塔通接手後 issuer 是 betaoi.cn,P110 又搬到 pass. 子域)。
  // ★★★ 危險在於**這份樣例正是裝機時被複製的那一份**:它用一個陳舊的值
  //   **覆蓋掉了程式碼里正確的預設值**,而那比「不寫這一行」更糟。
  // ⇒ 現在**整行刪掉**,用 AgentConfig 的內置預設。★ **除非你確知貝塔通換了 issuer 而 Agent
  //   還沒更新**,否則不要寫這一項 —— 寫了就等於又開一個會腐爛的地方。真要確認現值,打線上 discovery。
  // ⚠★★★ **「留空」與「不寫」不是一回事**:JSON 裡寫 "oidcIssuer": "" 會把內置預設
  //   **覆蓋成空串**(反序列化只認「鍵在不在」,不認「值是不是空」),
  //   ★ 表現是開考時 OidcLoginFlow 拋「oidc 模式需配 oidcIssuer」。⇒ 要用預設就**別寫這個鍵**。
  // P147/P149：裝機樣例繼續繼承已遷移的內置 issuer；現場 LAN 和動態 loopback 不變。
  "authMode": "oidc",
  "oidcClientId": "horus-client",

  // psk(legacy)模式才需要:authMode 改 "psk" 並補 psk + examId + seatId(oidc 模式留空/刪除)。
  "psk": "",
  "examId": "",
  "seatId": "",

  // 截圖/初判/白名單:均有內置預設(白名單預設洛谷 + 常見 IDE·且伺服器下發會覆蓋),一般全刪。
  "targetHeight": 1080,
  "webpQuality": 75,
  "baselineMinSeconds": 30,
  "baselineMaxSeconds": 90,
  "largePasteThreshold": 200,
  "whitelistHosts": ["luogu.com.cn", "www.luogu.com.cn"],
  "whitelistProcs": ["code", "devenv", "cl", "g++", "gcc", "edge", "explorer", "horus.agent", "dev-c++", "redpanda"]
}
