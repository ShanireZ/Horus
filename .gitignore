# === Horus 运行时 / 机密(切勿提交) ===
# 真实配置含 PSK / 管理令牌 / 视觉 API key —— 只提交 *.sample.json,真值放 *.config.json
agent.config.json
**/agent.config.json
server.config.json
**/server.config.json
# Agent 断网缓冲:运行时目录紧贴 exe(agent/Program.cs 用 AppContext.BaseDirectory/buffer),
# 即只会落在 agent/bin 或发布物 dist 之下;仅列运行时子目录,
# 避免笼统 **/buffer/ 在 Windows git 大小写不敏感下误吞源码目录 agentcore/Buffer/。
agent/bin/**/buffer/
dist/**/buffer/
# 服务器运行时:SQLite 库与证据截图
*.db
*.db-wal
*.db-shm
*.sqlite
/images/
/archive/
# 开发期从 server/ 起服务时的运行时数据目录(dataDir=./data → server/data;仅列运行时子目录,
# 避免笼统 server/data/ 在 Windows git 大小写不敏感下误吞源码目录 server/Data/)
server/data/images/
server/data/archive/
# CLIP ONNX 模型(~335MB·超 GitHub 单文件 100MB 上限)——部署时人工放置,不入 git
*.onnx

