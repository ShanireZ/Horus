<Project Sdk="Microsoft.NET.Sdk">

  <!-- Agent 與 Server 共用的線協定 / canonical / HMAC。刻意為平台無關 net8.0(非 -windows),
       以便 Server(net8.0) 與 Agent(net8.0-windows) 都能引用,保證雜湊與簽名兩端逐位元組一致。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Horus.Contracts</AssemblyName>
    <RootNamespace>Horus.Contracts</RootNamespace>
  </PropertyGroup>

</Project>
