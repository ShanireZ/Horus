{
  // 監考伺服器設定**樣例(範本·已提交進 git 公開儲存庫)**。複製為 server.config.json(已 gitignore)後按現場填真值。
  // ⚠️ 切勿把真實金鑰 / API key 填進本 sample 檔案 —— 會隨提交洩漏到公開儲存庫。真值只放 server.config.json。
  "urls": "http://0.0.0.0:8080",
  "dataDir": "./data",
  "dbPath": "horus.db",
  // 預共享 HMAC 金鑰(base64),必須與各 Agent 的 psk 一致。
  // 留空 = 關閉驗籤(僅本機整合測試用;生產務必設定)。
  // 生成示例(PowerShell): [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
  "pskBase64": "",
  // 擊鍵旁路金鑰(base64):判題後端持它對 /ingest/keystroke 提交體簽名(X-Horus-KSig)。
  // 留空 = 關閉擊鍵鑑權(僅整合測試)。生產接了判題埋點應設定,否則同網學員機可偽造/栽贓他人擊鍵樣本。與 psk 相互獨立。
  "keystrokeSecretBase64": "",
  // 管理/看板權杖:所有 /api/*(除 /api/login、/api/logout)需帶憑證。
  //   瀏覽器:POST /api/login {token} 檢核後種 HttpOnly cookie(JS 讀不到、不進 URL)——首選;
  //   指令碼用戶端:X-Horus-Admin 頭;圖片位元組端點相容 ?t= 查詢。
  // 留空 = 關閉管理鑑權(僅整合測試)。生產務必設定,否則同網學員機可下發設定關掉全場檢測/拉證據圖/抹裁決。
  "adminToken": "",
  // 非 loopback 綁定時,缺採集鑑權(PSK 或 OIDC)或 adminToken 會拒絕啟動(fail-closed)。僅本機整合測試可設 true 放行。
  "allowInsecure": false,
  // 啟動成功自動在預設瀏覽器打開管理端看板(僅交互式執行的真 exe;服務化/指令碼執行不彈)。
  "openDashboard": true,
  // Cloudflare Web Analytics 的公開 site token。僅未來啟用的 betaoi.cn 正式主機手動載入；LAN/IP 不出網。
  // `.cc` 由 Cloudflare 自動注入，不在這裡重複載入。也可用 env HORUS_CLOUDFLARE_WEB_ANALYTICS_TOKEN。
  "cloudflareWebAnalyticsToken": "c113fb69d7e84d38a645c5160f6f1bda",
  // ---- M4 身分層:wentian OIDC 取代共享 PSK(見 docs/m4-identity-oidc.md)----
  // authMode: "psk"(預設·共享 PSK) | "oidc"(僅 OIDC 工作階段) | "both"(遷移共存·可退回 PSK)。
  "authMode": "psk",
  // OIDC issuer:**貝塔通**的對外根網域。oidc/both 必配(留空會在啟動時拋,不會靜默放行)。
  // ⚠★★★ 2026-08-26:本行此前寫著「wentian 對外根網域,如 https://betaoi.cc」——**落后两代**
  //   (貝塔通接手後是 betaoi.cn,P110 又搬到 pass. 子域)。★ 這裡**有意不寫現值**:
  //   契約明寫「別把它抄進任何程式碼或寫死進設定的字面值裡」,而一個寫在註解裡的舉例
  //   ★★ **會被人當成可以照抄的值**,然後跟著上游一起腐爛 —— 上面那句就是這麼來的。
  //   ⇒ 真要知道現值,打線上 discovery;或看 AgentConfig.OidcIssuer 的內置預設。
  // P147/P149：Server 仍須由部署設定明確 issuer；不把主域再烤一份到樣例。
  "oidcIssuer": "",
  // Horus 在**貝塔通**註冊的 client_id。
  "oidcClientId": "horus-client",
  // client_secret:**把明文填進 oidcClientSecret,啟動一次即自動加密為 oidcClientSecretEnc 並清空明文**(同 visionApiKey 機制·DPAPI)。
  //   也可 `Horus.Server protect-secret <secret>` 預生成密文直接填 Enc、明文留空;或 env HORUS_OIDC_SECRET 注入(不寫入磁碟)。Server-Broker:secret 只在本伺服器。
  "oidcClientSecret": "",
  "oidcClientSecretEnc": "",
  // wentian JWKS(RSA 公鑰)內聯 JSON:區域網路離線驗 id_token。留空則啟動時從 issuer 拉取並快取(需啟動時可達 issuer)。
  "oidcJwksJson": "",
  // OIDC 工作階段有效期(分鐘):派發的採集憑證壽命,建議 ≥ 考試時長。預設 180。
  "oidcSessionMinutes": 180,
  // ---- M4·RBAC:監考員看板 OIDC 登入(wentian dashboard web client·取代靜態 adminToken·見 §10)----
  // adminAuthMode: "token"(預設·靜態 adminToken) | "oidc"(僅 wentian 長老 OIDC·R3 無權杖後門·監考員走 /admin/login)。
  "adminAuthMode": "token",
  // wentian dashboard web client_id(與 wentian OAUTH_HORUS_DASHBOARD_CLIENT_ID 一致)。adminAuthMode=oidc 必配。
  "oidcDashboardClientId": "horus-dashboard",
  // dashboard client_secret:**填明文進 oidcDashboardClientSecret,啟動自動加密為 oidcDashboardClientSecretEnc 並清空明文**(同上)。
  //   亦可 protect-secret 預生成填 Enc,或 env HORUS_OIDC_DASHBOARD_SECRET 注入。
  "oidcDashboardClientSecret": "",
  "oidcDashboardClientSecretEnc": "",
  // dashboard 回呼 URI:須與 wentian OAUTH_HORUS_DASHBOARD_REDIRECT_URIS 一條精確一致(如 https://<服务器>/cb)。
  "oidcDashboardRedirectUri": "",
  // 管理工作階段有效期(分鐘):監考員登入後憑證壽命,建議 ≥ 考試時長。預設 180。
  "adminSessionMinutes": 180,
  // ---- HTTPS(遠端監考工作站 OIDC 回呼須 https;自簽證書啟動生成)。Urls 含 https 時生效 ----
  // 額外 SAN 主機/IP(逗號分隔):填伺服器 LAN IP / 主機名,監考機才能驗通證書(localhost/127.0.0.1 自動含)。
  "httpsSanHosts": "",
  "riskThreshold": 50,
  "dedupImagesByPhash": true,
  "onlineWindowSeconds": 90,
  "recentRiskWindowSeconds": 300,
  // M3 歸檔 / 清理(architecture §13/§15):考試**結束**超 RetentionDays 天后,關鍵資料(可疑/裁決/高危事件+其證據圖/OCR/擊鍵)
  //   轉入 archive 庫、其餘就地清理、status='archived'、VACUUM 回收空間。仍有 pending 未裁決的考試會**跳過**(不 purge 未決案證據)。
  "archiveEnabled": true,
  "retentionDays": 30,
  // 關鍵資料判據:事件有效風險(max(agent,server))≥ 此值,或被 suspicious_queue 引用。
  "archiveCriticalRisk": 50,
  // 歸檔庫檔案(相對 dataDir);後台掃描間隔小時(≤0=關後台,仍可手動 POST /api/archive/run 觸發)。
  "archiveDbPath": "horus-archive.db",
  "archiveScanIntervalHours": 6,
  // 視覺分析(L2:視覺 LLM 取代 OCR + L3 Logo,合併單一視覺級)。一次呼叫做文字提取+介面/圖標識別+分類。
  // visionProvider: 留空/off=關(預設) | mock(確定性·整合測試) | openai(OpenAI 相容端點)。
  //   openai 通吃小米 MiMo-V2.5 / DeepSeek-V4 / Qwen-VL / GLM-4V —— 換供應商=換 baseUrl+model+key。
  //   ★ owner 選定 = 小米 MiMo-V2.5 託管 API(境內雲,OpenAI 相容):
  "visionProvider": "openai",
  "visionBaseUrl": "https://token-plan-cn.xiaomimimo.com/v1",
  "visionModel": "mimo-v2.5",
  // ★ API key:在 **server.config.json**(非本 sample)裡把明文填到 visionApiKey,伺服器啟動會**自動加密**為下面的 visionApiKeyEnc 並**清空本欄位**。
  "visionApiKey": "",
  // 自動生成的 DPAPI 密文(機器綁定·勿手改)。也可用 `Horus.Server protect-secret <key>` 預生成後直接填這裡、visionApiKey 留空。
  "visionApiKeyEnc": "",
  "visionConfidenceThreshold": 60,
  "visionAnalyzeBaseline": false,
  // 基線分析抽樣率 N:visionAnalyzeBaseline=true 時只分析 1/N 的隨機基線圖(確定性按 imageId·跨重新啟動一致·控雲成本)。預設 1=全分析;設 10≈分析 10%。
  "visionBaselineSampleRate": 1,
  // 補償重掃間隔(分鐘):週期性拾回被佇列丟棄/重新啟動丟記憶體佇列/臨時雲失敗的未分析觸發型證據圖。預設 5;≤0=關閉。
  "visionBackstopMinutes": 5,
  // 單張圖視覺分析最大認領次數(含失敗):臨時雲失敗由補償重掃重試,達此上限放棄防死循環。預設 5。
  "visionMaxAttempts": 5,
  // §5 送雲前派生處理(owner 決策 2026-07-02:不再打碼/裁剪,只降取樣;供應商=境內雲 MiMo·PIPL 無跨境):
  //   visionMaxEdge: 送雲圖長邊像素上限(降取樣省 token·順帶剝離 EXIF/XMP/ICC 中繼資料)。預設 1600;0=不降取樣直通。原圖永不出網,只送派生圖。
  "visionMaxEdge": 1600,
  // ---- M3 CLIP 按圖搜圖(provider-agnostic 嵌入器·C# 暴力餘弦·無需 sqlite-vec·僅嵌證據圖)----
  // embedProvider: 留空/"off"=關(預設) | "mock"(確定性·測試) | "onnx"(本機 CLIP ONNX·推薦·零出網) | "openai"(OpenAI 相容 /v1/embeddings)。
  //   ★探測過:小米 MiMo-V2.5 **無** /v1/embeddings 端點(僅對話/視覺/ASR/TTS)→ 重複使用視覺 key 走不通,故用本機 onnx。
  //   部署前可 `Horus.Server probe-embed [model]` 探測某雲端點是否有圖像 embedding 模型。
  "embedProvider": "",
  // --- provider=onnx(本機 CLIP·推薦·零出網)---
  // embedOnnxModelPath: CLIP ViT-B/32 **圖像編碼器** ONNX(512 維)。★約定檔案名 = model.onnx:
  //   **留空 = 預設找 dataDir\model.onnx**(與推薦倉原始檔案名一致,下載免改名);放別處才顯式填(相對 dataDir 或絕對)。
  //   下載(推薦·MIT·352MB): https://huggingface.co/Qdrant/clip-ViT-B-32-vision/resolve/main/model.onnx
  //   小體積備選(下載後**改名 model.onnx**): https://huggingface.co/Xenova/clip-vit-base-patch32/resolve/main/onnx/vision_model.onnx (或 vision_model_quantized.onnx int8)
  "embedOnnxModelPath": "",
  // embedOnnxInput / embedOnnxOutput: 張量名。**留空即可**——自動選(輸入取首個;輸出優先名含 embed/pool 的·正確取嵌入向量)。特殊模型用 Netron 看輸出名再填。
  "embedOnnxInput": "",
  "embedOnnxOutput": "",
  // embedCosineFloor: 按圖搜圖餘弦下限(低於此分的影格視為無關被過濾·預設 0.2);設為 0 則不過濾(退回舊行為·可能混入無關影格)。
  "embedCosineFloor": 0.2,
  // --- provider=openai(雲·僅當有圖像/多模態 embedding 端點時)---
  // embedBaseUrl: 留空則重複使用 visionBaseUrl(KEY一致);/embeddings 從此拼。embedModel/embedApiKey(留空重複使用視覺 key·env HORUS_EMBED_KEY)。
  "embedBaseUrl": "",
  "embedModel": "",
  "embedApiKey": "",
  // embedDim: 嵌入維度(暴力餘弦無所謂·僅記錄)。預設 512(CLIP ViT-B/32)。
  "embedDim": 512,
  // embedBackstopMinutes: 後台補嵌間隔(分鐘)·拾回證據圖裡尚無 embedding 的。預設 5;≤0=關閉。
  "embedBackstopMinutes": 5
}
