<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 監考伺服器:接收(WS 事件 + HTTP 圖片/擊鍵) + 寫入資料庫(SQLite + 檔案) + 簡易看板。
       net8.0(非 -windows):筆記本上 Windows 可跑,也便於測試。對外聯網僅 M2 視覺 LLM 識圖。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Horus.Server</AssemblyName>
    <RootNamespace>Horus.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.28" />
    <!-- DPAPI:视觉端点 API key 加密存储配置文件(不存明文),读取时机器绑定解密。仅 Windows 运行时。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- §5 收口:送云视觉 LLM 前对截图 decode/裁剪/打码身份/降采样再 re-encode(与 Agent 同版,WebP 互通)。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- M3 按图搜图:本地 ONNX CLIP 图像编码器推理(CPU·无需 GPU)。仅 embedProvider=onnx 时加载模型;Mock/关时不触发。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共享线协议 / canonical / HMAC(与 Agent 共用,验签同源) -->
    <ProjectReference Include="..\contracts\Horus.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定檔案**不隨發佈拷貝**:真 server.config.json 含金鑰(勿進成品包·防洩漏);範本/參考由部署時手放。
         Web SDK 預設把 *.json 當 Content 拷進 publish 輸出,此處顯式關掉。 -->
    <Content Update="server.config.json;server.config.sample.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 权威 DDL 内嵌进程序集(路径无关,测试也能读到)。启动时执行,M1 剥离 vec0 虚表。 -->
    <EmbeddedResource Include="..\schema\schema.sql" Link="schema.sql" />
    <!-- 归档库 DDL:M3 归档作业首次运行时应用到 archive 文件(idempotent)。 -->
    <EmbeddedResource Include="..\schema\schema-archive.sql" Link="schema-archive.sql" />
  </ItemGroup>

</Project>
